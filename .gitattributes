# Normalise line endings.
# Text files are stored with LF in the repository and checked out with the
# platform's native endings. Without this, files written on Windows show as
# entirely rewritten in every diff even when nothing has changed.
* text=auto

# Explicitly text, so they are always normalised
*.qmd    text
*.Rmd    text
*.R      text
*.md     text
*.yml    text
*.yaml   text
*.html   text
*.css    text
*.csv    text
*.Rproj  text
LICENSE  text

# Binary - never normalise or diff these as text
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.pdf        binary
*.rds        binary
*.RData      binary
*.parquet    binary
*.geoparquet binary
*.xlsx       binary
